  "gold_enabled": true,
  "gold_target_schema": "{gold_target_schema}",
  "gold_models_path": "gold/models",
  "layer": "bronze_silver",
  "pipeline_mode": "split",
  "source_format": "cloudFiles",
  "onboarding_file_format": "yaml",
  "quality_engine": "none",
  "managed_quality_migrations": false,
  "dataflow_group": "dab_demo_gold_group",
  "wheel_source": "volume_path",
  "sdp_meta_dependency": "__SET_ME__",
  "author": "dab-template-demo"
}
