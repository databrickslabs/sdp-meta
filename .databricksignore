# Exclude folders not needed by the Databricks App at runtime.
# databricks sync respects this file like .gitignore.

# NOTE: do NOT add bare `templates/` or `static/` here — .databricksignore
# uses .gitignore matching, so an unanchored pattern would also exclude the
# App's own `databricks_app/templates/` (landingPage.html) and
# `src/databricks/labs/sdp_meta/templates/dab`, breaking the running App.
.github/
docs/
tests/

# Build artifacts (regenerated by start.sh in the container)
dist/
build/
*.egg-info/
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/

# Dev/config files not needed in the container
.coveragerc
.flake8
.gitmodules
authors.txt
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# Notebook archives (.dbc) — UI-import bundles, NOT needed at runtime.
# `databricks sync` cannot overwrite existing .dbc workspace files, which
# breaks every re-sync. The App always uses the underlying .py notebooks.
**/*.dbc
