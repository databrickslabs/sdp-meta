# All knobs for the {{.bundle_name}} sdp-meta bundle.
# Override any of these per target in databricks.yml under `targets.<name>.variables`.

variables:
  uc_catalog_name:
    description: Unity Catalog catalog where the sdp-meta schema and bronze/silver schemas live.
    default: {{.uc_catalog_name}}

  sdp_meta_schema:
    description: Schema that holds the bronze_dataflowspec / silver_dataflowspec tables.
    default: {{.sdp_meta_schema}}

  bronze_target_schema:
    description: Schema where the bronze SDP Pipeline writes its tables.
    default: {{.bronze_target_schema}}

  silver_target_schema:
    description: Schema where the silver SDP Pipeline writes its tables.
    default: {{.silver_target_schema}}

  layer:
    description: Layer to onboard. One of `bronze`, `silver`, `bronze_silver`.
    default: {{.layer}}

  pipeline_mode:
    description: |
      Only consulted when layer=bronze_silver. `split` keeps two SDP Pipelines
      (silver depends on bronze); `combined` collapses both layers into one
      SDP Pipeline using sdp-meta's `bronze_silver` runtime mode.
    default: {{.pipeline_mode}}

  dataflow_group:
    description: |
      data_flow_group used by the seeded flow(s) and referenced from the SDP
      pipeline `configuration` as `bronze.group` / `silver.group`.
    default: {{.dataflow_group}}

  quality_migration_timeout_seconds:
    description: |
      Total time budget shared by the selective quarantine refresh and the
      subsequent full pipeline update.
    default: 10800

  onboarding_file_name:
    description: Filename (inside conf/) of the onboarding file uploaded with this bundle.
    default: onboarding.{{if eq .onboarding_file_format "yaml"}}yml{{else}}json{{end}}

  conf_volume:
    description: |
      UC Volume (inside sdp_meta_schema) that the onboarding job stages conf/
      into before onboarding runs. Serverless Spark cannot read conf files from
      the workspace file path, so the `stage_conf` task copies conf/ here and the
      onboarding + pipelines read from the volume. Created automatically if it
      does not exist.
    default: bundle_conf

  bronze_dataflowspec_table:
    description: Bronze dataflowspec table name inside `sdp_meta_schema`.
    default: bronze_dataflowspec

  silver_dataflowspec_table:
    description: Silver dataflowspec table name inside `sdp_meta_schema`.
    default: silver_dataflowspec

  dataflowspec_version:
    description: Value written to the `version` column of dataflowspec rows.
    default: v1

  sdp_meta_version:
    description: |
      Value stamped on every SDP Pipeline as the `sdp_meta` tag. The SDP-META
      monitoring App (and the workspace UI tag search) find pipelines by this
      tag, so bundle-deployed pipelines show up next to ones created by
      `sdp-meta deploy` / `deploy_ui`. Any non-empty value is enough for
      discovery; a version string (e.g. 0.1.0) is additionally shown as the
      pipeline's version in the App. `databricks labs sdp-meta bundle-init`
      stamps the installed sdp-meta version here automatically; the `true`
      sentinel is the safe fallback for a raw `databricks bundle init`.
    default: "true"

  author:
    description: Value written to the `import_author` column of dataflowspec rows.
    default: {{.author}}

  overwrite_dataflowspecs:
    description: If "True", onboarding overwrites existing dataflowspec rows; if "False" it merges.
    default: "True"

  wheel_source:
    description: |
      Documents (and lets `bundle-validate` enforce) which install style this
      bundle uses. `pypi` -> `sdp_meta_dependency` should be a coordinate.
      `volume_path` -> `sdp_meta_dependency` should start with `/Volumes/`.
    default: {{.wheel_source}}

  sdp_meta_dependency:
    description: |
      Concrete value the bundle pins for installs. The runner notebook will
      `pip install` this verbatim and the onboarding job consumes it as an
      environments dependency. Must match `wheel_source`. The sentinel
      `__SET_ME__` will fail-fast at validate and at runtime.
    default: {{.sdp_meta_dependency}}

  # NOTE: no `type:` on these booleans. Databricks bundles only accept
  # `type: complex` (for maps/arrays); `type: bool` is rejected with
  # "invalid value \"bool\" for enum field. Valid values are [complex]".
  # Each is consumed as a lone reference (e.g. `serverless: ${var.serverless}`),
  # and DAB preserves the resolved value's type for lone references, so the
  # unquoted YAML boolean `default: true` stays a real boolean at the SDK
  # boundary without any `type:` declaration.
  serverless:
    description: Run the SDP Pipelines on serverless compute.
    default: true

  photon_enabled:
    description: Enable Photon on the SDP Pipelines (ignored on serverless).
    default: true

  development_enabled:
    description: Set the SDP Pipeline `development` flag. Overridden per-target in databricks.yml.
    default: true
