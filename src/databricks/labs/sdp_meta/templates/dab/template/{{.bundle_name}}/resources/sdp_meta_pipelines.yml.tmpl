# Lakeflow Spark Declarative Pipelines driven by sdp-meta. The runner notebook reads
# `layer` and `*.dataflowspecTable` from the pipeline configuration and asks
# sdp-meta to build the SDP graph.
#
# Render-time topology (layer={{.layer}}{{if eq .layer "bronze_silver"}}, pipeline_mode={{.pipeline_mode}}{{end}}):
{{- if eq .layer "bronze"}}
#   - one pipeline `bronze`
{{- else if eq .layer "silver"}}
#   - one pipeline `silver`
{{- else if and (eq .layer "bronze_silver") (eq .pipeline_mode "combined")}}
#   - one pipeline `bronze_silver` that materializes both layers in one DAG
{{- else}}
#   - two pipelines `bronze` and `silver`; the `pipelines` job runs silver after bronze
{{- end}}

resources:
  pipelines:
{{- if eq .layer "bronze"}}
    bronze:
      name: "${bundle.name} - bronze"
      # Tag stamped so the SDP-META App / UI tag search find this pipeline
      # even though it was created by `databricks bundle` rather than
      # `sdp-meta deploy`. See `sdp_meta_version` in resources/variables.yml.
      tags:
        sdp_meta: ${var.sdp_meta_version}
      catalog: ${var.uc_catalog_name}
      schema: ${var.bronze_target_schema}
      development: ${var.development_enabled}
      photon: ${var.photon_enabled}
      serverless: ${var.serverless}
      libraries:
        - notebook:
            path: ${workspace.file_path}/notebooks/init_sdp_meta_pipeline
      configuration:
        layer: bronze
        bronze.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}
        bronze.group: ${var.dataflow_group}
        sdp_meta_dependency: ${var.sdp_meta_dependency}
{{- else if eq .layer "silver"}}
    silver:
      name: "${bundle.name} - silver"
      # Tag stamped so the SDP-META App / UI tag search find this pipeline
      # even though it was created by `databricks bundle` rather than
      # `sdp-meta deploy`. See `sdp_meta_version` in resources/variables.yml.
      tags:
        sdp_meta: ${var.sdp_meta_version}
      catalog: ${var.uc_catalog_name}
      schema: ${var.silver_target_schema}
      development: ${var.development_enabled}
      photon: ${var.photon_enabled}
      serverless: ${var.serverless}
      libraries:
        - notebook:
            path: ${workspace.file_path}/notebooks/init_sdp_meta_pipeline
      configuration:
        layer: silver
        silver.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}
        silver.group: ${var.dataflow_group}
        sdp_meta_dependency: ${var.sdp_meta_dependency}
{{- else if and (eq .layer "bronze_silver") (eq .pipeline_mode "combined")}}
    # Combined mode: one SDP Pipeline materializes both bronze and silver tables
    # in a single DAG. sdp-meta dispatches on `layer=bronze_silver` and reads
    # both `bronze.dataflowspecTable` and `silver.dataflowspecTable` below.
    # `schema` is the SDP-level default; sdp-meta still writes each table to
    # its own (catalog, schema) from the dataflowspec rows, so bronze tables
    # land in `bronze_target_schema` and silver tables in `silver_target_schema`.
    bronze_silver:
      name: "${bundle.name} - bronze+silver"
      # Tag stamped so the SDP-META App / UI tag search find this pipeline
      # even though it was created by `databricks bundle` rather than
      # `sdp-meta deploy`. See `sdp_meta_version` in resources/variables.yml.
      tags:
        sdp_meta: ${var.sdp_meta_version}
      catalog: ${var.uc_catalog_name}
      schema: ${var.bronze_target_schema}
      development: ${var.development_enabled}
      photon: ${var.photon_enabled}
      serverless: ${var.serverless}
      libraries:
        - notebook:
            path: ${workspace.file_path}/notebooks/init_sdp_meta_pipeline
      configuration:
        layer: bronze_silver
        bronze.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}
        bronze.group: ${var.dataflow_group}
        silver.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}
        silver.group: ${var.dataflow_group}
        sdp_meta_dependency: ${var.sdp_meta_dependency}
{{- else}}
    bronze:
      name: "${bundle.name} - bronze"
      # Tag stamped so the SDP-META App / UI tag search find this pipeline
      # even though it was created by `databricks bundle` rather than
      # `sdp-meta deploy`. See `sdp_meta_version` in resources/variables.yml.
      tags:
        sdp_meta: ${var.sdp_meta_version}
      catalog: ${var.uc_catalog_name}
      schema: ${var.bronze_target_schema}
      development: ${var.development_enabled}
      photon: ${var.photon_enabled}
      serverless: ${var.serverless}
      libraries:
        - notebook:
            path: ${workspace.file_path}/notebooks/init_sdp_meta_pipeline
      configuration:
        layer: bronze
        bronze.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}
        bronze.group: ${var.dataflow_group}
        sdp_meta_dependency: ${var.sdp_meta_dependency}
    silver:
      name: "${bundle.name} - silver"
      # Tag stamped so the SDP-META App / UI tag search find this pipeline
      # even though it was created by `databricks bundle` rather than
      # `sdp-meta deploy`. See `sdp_meta_version` in resources/variables.yml.
      tags:
        sdp_meta: ${var.sdp_meta_version}
      catalog: ${var.uc_catalog_name}
      schema: ${var.silver_target_schema}
      development: ${var.development_enabled}
      photon: ${var.photon_enabled}
      serverless: ${var.serverless}
      libraries:
        - notebook:
            path: ${workspace.file_path}/notebooks/init_sdp_meta_pipeline
      configuration:
        layer: silver
        silver.dataflowspecTable: ${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}
        silver.group: ${var.dataflow_group}
        sdp_meta_dependency: ${var.sdp_meta_dependency}
{{- end}}

  jobs:
    pipelines:
      name: "${bundle.name} - run pipelines"
      description: "Runs the sdp-meta SDP Pipeline(s) end-to-end."
      tasks:
{{- if .managed_quality_migrations}}
{{- if eq .layer "bronze"}}
        - task_key: bronze
          python_wheel_task:
            package_name: databricks_labs_sdp_meta
            entry_point: quality_migrate
            named_parameters:
              pipeline_id: ${resources.pipelines.bronze.id}
              spec_tables: '{"bronze":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}"}'
              groups: '{"bronze":"${var.dataflow_group}"}'
              timeout_seconds: ${var.quality_migration_timeout_seconds}
          timeout_seconds: ${var.quality_migration_timeout_seconds}
          environment_key: quality_migration
{{- else if eq .layer "silver"}}
        - task_key: silver
          python_wheel_task:
            package_name: databricks_labs_sdp_meta
            entry_point: quality_migrate
            named_parameters:
              pipeline_id: ${resources.pipelines.silver.id}
              spec_tables: '{"silver":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}"}'
              groups: '{"silver":"${var.dataflow_group}"}'
              timeout_seconds: ${var.quality_migration_timeout_seconds}
          timeout_seconds: ${var.quality_migration_timeout_seconds}
          environment_key: quality_migration
{{- else if and (eq .layer "bronze_silver") (eq .pipeline_mode "combined")}}
        - task_key: bronze_silver
          python_wheel_task:
            package_name: databricks_labs_sdp_meta
            entry_point: quality_migrate
            named_parameters:
              pipeline_id: ${resources.pipelines.bronze_silver.id}
              spec_tables: '{"bronze":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}","silver":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}"}'
              groups: '{"bronze":"${var.dataflow_group}","silver":"${var.dataflow_group}"}'
              timeout_seconds: ${var.quality_migration_timeout_seconds}
          timeout_seconds: ${var.quality_migration_timeout_seconds}
          environment_key: quality_migration
{{- else}}
        - task_key: bronze
          python_wheel_task:
            package_name: databricks_labs_sdp_meta
            entry_point: quality_migrate
            named_parameters:
              pipeline_id: ${resources.pipelines.bronze.id}
              spec_tables: '{"bronze":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.bronze_dataflowspec_table}"}'
              groups: '{"bronze":"${var.dataflow_group}"}'
              timeout_seconds: ${var.quality_migration_timeout_seconds}
          timeout_seconds: ${var.quality_migration_timeout_seconds}
          environment_key: quality_migration
        - task_key: silver
          python_wheel_task:
            package_name: databricks_labs_sdp_meta
            entry_point: quality_migrate
            named_parameters:
              pipeline_id: ${resources.pipelines.silver.id}
              spec_tables: '{"silver":"${var.uc_catalog_name}.${var.sdp_meta_schema}.${var.silver_dataflowspec_table}"}'
              groups: '{"silver":"${var.dataflow_group}"}'
              timeout_seconds: ${var.quality_migration_timeout_seconds}
          timeout_seconds: ${var.quality_migration_timeout_seconds}
          environment_key: quality_migration
          depends_on:
            - task_key: bronze
{{- end}}
{{- else}}
{{- if eq .layer "bronze"}}
        - task_key: bronze
          pipeline_task:
            pipeline_id: ${resources.pipelines.bronze.id}
            full_refresh: false
{{- else if eq .layer "silver"}}
        - task_key: silver
          pipeline_task:
            pipeline_id: ${resources.pipelines.silver.id}
            full_refresh: false
{{- else if and (eq .layer "bronze_silver") (eq .pipeline_mode "combined")}}
        - task_key: bronze_silver
          pipeline_task:
            pipeline_id: ${resources.pipelines.bronze_silver.id}
            full_refresh: false
{{- else}}
        - task_key: bronze
          pipeline_task:
            pipeline_id: ${resources.pipelines.bronze.id}
            full_refresh: false
        - task_key: silver
          pipeline_task:
            pipeline_id: ${resources.pipelines.silver.id}
            full_refresh: false
          depends_on:
            - task_key: bronze
{{- end}}
{{- end}}
{{- if .managed_quality_migrations}}
      environments:
        - environment_key: quality_migration
          spec:
            client: "1"
            dependencies:
              - ${var.sdp_meta_dependency}
{{- if eq .quality_engine "dqx"}}
              - databricks-labs-dqx>=0.14,<0.17
{{- end}}
{{- end}}
